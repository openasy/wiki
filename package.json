{
  "name": "@openasy/wiki",
  "version": "0.1.1",
  "private": true,
  "description": "OpenAsy Wiki: the company's own handbook and how-tos, in spaces by team, written in the browser, searchable, with owners, reviews and policies people confirm they have read.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openasy/wiki.git"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "start": "node server/main.ts",
    "build": "vite build --config web/vite.config.ts && node scripts/build-docs.ts",
    "openapi": "node scripts/openapi.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "prettier": "@openasy/code-style/prettier",
  "devDependencies": {
    "@openasy/code-style": "https://github.com/openasy/code-style/releases/download/v0.1.2/openasy-code-style-0.1.2.tgz",
    "@openasy/ui": "https://github.com/openasy/ui/releases/download/v0.17.0/openasy-ui-0.17.0.tgz",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/smtp-server": "^3.5.13",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "lucide-react": "^1.59.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smtp-server": "^3.21.3",
    "swagger-ui-dist": "^5.34.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.12.0",
    "npm": ">=11"
  },
  "dependencies": {
    "@openasy/auth": "https://github.com/openasy/auth/releases/download/v0.11.1/openasy-auth-0.11.1.tgz",
    "dom-serializer": "^3.1.1",
    "htmlparser2": "^12.0.0",
    "marked": "^18.1.3",
    "node-diff3": "^3.2.1",
    "nodemailer": "^10.4.0",
    "sanitize-html": "^2.18.1",
    "turndown": "^7.2.5",
    "yaml": "^2.9.1"
  }
}
